# DBWCARE Board – Lokale Full-Stack-Umgebung
# Kopiere diese Datei zu .env.dbwcare-local und passe ggf. an.
# Wird von docker-compose.dbwcare-local.yml und dev-local.sh verwendet.
# NICHT committen! (.gitignore)

# ─── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_HOST=plane-db
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:plane@plane-db:5432/plane

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# ─── RabbitMQ ─────────────────────────────────────────────────────────
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane

# ─── Minio (S3-kompatibel) ───────────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
USE_MINIO=1
MINIO_ENDPOINT_SSL=0

# ─── Django / API ─────────────────────────────────────────────────────
DEBUG=1
SECRET_KEY=local-dev-not-secret-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100
DOCKERIZED=1
GUNICORN_WORKERS=2
SIGNED_URL_EXPIRATION=3600

# Email: nur Console-Output, kein SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ─── URLs (wie Plane sie intern nutzt) ────────────────────────────────
WEB_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
APP_BASE_PATH=
ADMIN_BASE_URL=http://localhost:3001
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=http://localhost:3002
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=http://localhost:3100
LIVE_BASE_PATH=/live
LIVE_SERVER_SECRET_KEY=local-dev-live-secret

# ─── Sonstiges ────────────────────────────────────────────────────────
HARD_DELETE_AFTER_DAYS=60
API_KEY_RATE_LIMIT=60/minute
